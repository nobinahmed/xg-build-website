# Serve the site on https://xgbuild.com.au (no www).
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://xgbuild.com.au%{REQUEST_URI} [L,R=301]

# Clean URLs: /privacy serves privacy.html. Old links are redirected:
# /index.html -> /, /privacy.html -> /privacy, /privacy/ -> /privacy.
# THE_REQUEST is the original request line, so internal rewrites don't loop.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]

ErrorDocument 404 /404.shtml

# Compress text files (HTML/CSS are already gzipped by the host; this covers the rest).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser caching. Images and videos rarely change (give a replacement a new
# file name), so cache them for 30 days. HTML, CSS and JS are revalidated on
# every visit so deploys show up immediately; unchanged files return a cheap 304.
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|shtml|css|js|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
